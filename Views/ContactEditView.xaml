<UserControl x:Class="MVVM.Views.ContactEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Редактирование контакта"
FontSize="20" FontWeight="Bold" />
        <TextBox Text="{Binding EditName,
UpdateSourceTrigger=PropertyChanged}" Margin="0,10"/>
        <TextBox Text="{Binding EditPhone,
UpdateSourceTrigger=PropertyChanged}" Margin="0,10"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Сохранить"
Command="{Binding SaveCommand}" Margin="5"/>
            <Button Content="Отмена"
Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
    </StackPanel>
</UserControl>
