<Application x:Class="MVVM.App"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Views="clr-namespace:MVVM.Views"
             xmlns:ViewModels="clr-namespace:MVVM.ViewModels"
             >
    <Application.Resources>
        
        <DataTemplate DataType="{x:Type ViewModels:ContactsListViewModel}">
            <Views:ContactsListView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type ViewModels:AboutViewModel}">
            <Views:AboutView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:ContactEditViewModel}">
            <Views:ContactEditView />
        </DataTemplate>

    </Application.Resources>
</Application>